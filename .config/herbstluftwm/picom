rules = (
	{
		# active window (urxvt)
		match = "class_g != 'URxvt' && focused";
		opacity = 1.0;
	},
	{
		# active window
		match = "focused";
		opacity = 1.0;
		blur-background = true;
	},
	{
		# inactive window
		match = "!focused";
		dim = 0.6;
		opacity = 0.98;
		blur-background = false;
	},
	{
		# inactive discord window
		match = "class_g='discord' && !focused";
		dim = 0.6;
	},
	{
		# inactive drawpile window
		match = "class_g='drawpile' && !focused";
		dim = 0.0;
		opacity = 1.0;
	},
	{
		# barif they come out the right side of the screen and move left
		match = "class_i='lemonbar' && !focused";
		dim = 0.0;
		opacity = 0.85;
		shadow = true;
		corner-radius: 0;
	},
);

backend = "glx";
vsync = true;
# glx-no-stencil = true;
# glx-copy-from-front = false;
# glx-no-rebind-pixmap = true;
# inactive-dim = 0.8;
corner-radius: 4;
use-damage = true;

# shadows -------------------------------------------------------------------@/
shadow = true;
shadow-radius: 9;
shadow-opacity: .6;
shadow-offset-x: -5;
shadow-offset-y: -5;
shadow-color: "#200115";

blur: {
	method = "dual_kawase";
	strength = 2.3;
	deviation = 1.0;
};

